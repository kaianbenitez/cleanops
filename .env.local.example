# Core values are required; integration values are optional until configured.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte key, base64 encoded. Required only before saving encrypted integration keys.
SETTINGS_ENCRYPTION_KEY=

# UUID of the company that GoHighLevel sends leads for.
GHL_PRIMARY_COMPANY_ID=

# Resend API key, used to send transactional email (currently: new-lead alerts).
RESEND_API_KEY=

# Inbox that receives a new-lead email alert. Leave unset to skip the email.
LEAD_NOTIFICATION_EMAIL=
